# Workflowy MCP Server (wf-cli backed) — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Required: Workflowy API key (from https://workflowy.com/account/api)
# Used only on first container boot to run `wf login --stdin`; after that,
# the key lives in the persisted ~/.workflowy/config.json volume.
WORKFLOWY_API_KEY=your-api-key-here

# Required for network exposure: bearer token enforced by `wf mcp` on the
# HTTP transport. Send as `Authorization: Bearer <token>` from the client
# / reverse proxy.
WORKFLOWY_MCP_AUTH_TOKEN=changeme

# Optional: internal port wf mcp binds to on loopback (default: 3399)
WF_MCP_PORT=3399

# Optional: port the in-container socat forwarder publishes on 0.0.0.0,
# matching the Docker/nginx published port (default: 3001)
WF_MCP_PUBLIC_PORT=3001